{"items": [
  {"id": "newsletters", "name": "Newsletters", "description": "Newsletters and promos you rarely open",
   "rule": {"name": "Newsletters", "template": "Newsletters", "intent": "Newsletters and promotional emails",
            "actions": [{"type": "move", "folder": "Reading"}, {"type": "read"}], "new_folders": ["Reading"]}},
  {"id": "receipts", "name": "Receipts", "description": "Purchase receipts and invoices",
   "rule": {"name": "Receipts", "template": "Receipts", "intent": "Receipts and invoices for purchases",
            "actions": [{"type": "move", "folder": "Receipts"}], "new_folders": ["Receipts"]}},
  {"id": "login-codes", "name": "Login codes", "description": "OTPs and verification codes stay on top",
   "rule": {"name": "Login codes", "template": "Login codes",
            "conditions": {"field": "subject", "op": "contains_any", "value": ["code", "OTP", "verification"]},
            "actions": [{"type": "keep"}, {"type": "flag"}]}},
  {"id": "cold-sales", "name": "Cold sales", "description": "Pitches from people you never emailed",
   "rule": {"name": "Cold sales", "template": "Cold sales", "intent": "Cold sales pitches and unsolicited demo requests",
            "actions": [{"type": "trash"}], "min_confidence": 0.9}},
  {"id": "recruiters", "name": "Recruiters", "description": "Recruiter outreach to Jobs, unless you've replied",
   "rule": {"name": "Recruiters", "template": "Recruiters", "intent": "Recruiter outreach about job openings",
            "exceptions": {"field": "replied_before", "op": "eq", "value": true},
            "actions": [{"type": "move", "folder": "Jobs"}], "new_folders": ["Jobs"]}},
  {"id": "travel", "name": "Travel", "description": "Tickets, bookings and itineraries",
   "rule": {"name": "Travel", "template": "Travel", "intent": "Train, flight and hotel bookings",
            "actions": [{"type": "move", "folder": "Travel"}], "new_folders": ["Travel"]}},
  {"id": "social-notifications", "name": "Social notifications", "description": "Likes, follows and profile views",
   "rule": {"name": "Social notifications", "template": "Social notifications",
            "conditions": {"field": "from_domain", "op": "in", "value": ["linkedin.com", "facebookmail.com", "x.com"]},
            "actions": [{"type": "archive"}, {"type": "read"}]}},
  {"id": "bank-statements", "name": "Bank statements", "description": "Statements and card bills to Finance",
   "rule": {"name": "Bank statements", "template": "Bank statements", "intent": "Bank statements and credit card bills",
            "conditions": {"field": "has_attachment", "op": "eq", "value": true},
            "actions": [{"type": "move", "folder": "Finance"}], "new_folders": ["Finance"]}},
  {"id": "calendar-invites", "name": "Calendar invites", "description": "Meeting invites stay in Inbox, flagged",
   "rule": {"name": "Calendar invites", "template": "Calendar invites",
            "conditions": {"field": "attachment_ext", "op": "in", "value": ["ics"]},
            "actions": [{"type": "keep"}, {"type": "flag"}]}}
]}
